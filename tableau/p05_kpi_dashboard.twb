    <worksheet name='Water Usage by Stress Tier and Cooling System'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Arial Black' fontsize='8'>Evaporative cooling accounts for the overwhelming majority of water consumption across all three stress tiers, while Air Cooled and Liquid Cooled systems use comparatively negligible water. This suggests facilities located in High and Medium water-stress regions that still rely on evaporative cooling face the greatest sustainability risk, and would benefit most from transitioning to Air Cooled or Liquid Cooled systems.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data_center_hybrid' name='federated.0hi8aej11rsygq19lugmx05gomdm' />
          </datasources>
          <datasource-dependencies datasource='federated.0hi8aej11rsygq19lugmx05gomdm'>
            <column caption='Cooling System Type' datatype='string' name='[Cooling_System_Type]' role='dimension' type='nominal' />
            <column caption='Daily Water Usage Gallons' datatype='real' name='[Daily_Water_Usage_Gallons]' role='measure' type='quantitative' />
            <column caption='Surrounding Water Stress Tier' datatype='string' name='[Surrounding_Water_Stress_Tier]' role='dimension' type='nominal' />
            <column-instance column='[Cooling_System_Type]' derivation='None' name='[none:Cooling_System_Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Surrounding_Water_Stress_Tier]' derivation='None' name='[none:Surrounding_Water_Stress_Tier:nk]' pivot='key' type='nominal' />
            <column-instance column='[Daily_Water_Usage_Gallons]' derivation='Sum' name='[sum:Daily_Water_Usage_Gallons:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.0hi8aej11rsygq19lugmx05gomdm].[none:Surrounding_Water_Stress_Tier:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Low&quot;</bucket>
              <bucket>&quot;Medium&quot;</bucket>
              <bucket>&quot;High&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
